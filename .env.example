# Example environment for `docker compose` (server mode).
# Copy to `.env`, fill in the two required secrets, and never commit `.env`.
# Full reference: docs/operations/RUNBOOK.md section 8 and docs/architecture/operations.md.

# --- Required: compose refuses to start without these ---
# Database password for the bundled PostgreSQL service.
RC_DB_PASSWORD=
# Signing key for OIDC flow cookies. Use the same value on every replica.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RC_AUTH_SECRET=

# --- Authentication ---
# `server` requires login. `local` treats every request as the single admin user and is
# only allowed on a loopback bind.
RC_AUTH_MODE=server
# The account with this address becomes the first admin once its email is verified
# (only while no admin exists). Alternatively run: rc api promote-admin EMAIL
RC_AUTH_ADMIN_EMAIL=
# Public web address, used in password-reset links and OIDC return URLs.
RC_PUBLIC_URL=http://localhost:3000
# Keep `1` behind HTTPS. `0` is for plain-HTTP development only.
RC_AUTH_COOKIE_SECURE=1
# OIDC providers as JSON (see docs/adr/0010). Leave empty to disable OIDC login.
RC_OIDC_PROVIDERS=

# --- Mail (password reset and email verification; without it those return 503) ---
RC_SMTP_HOST=
RC_SMTP_PORT=587
RC_SMTP_USER=
RC_SMTP_PASSWORD=
RC_SMTP_FROM=

# --- API server ---
RC_API_HOST=0.0.0.0
RC_API_PORT=8000
RC_API_LOG_LEVEL=info
# `0` turns /metrics into a 404.
RC_API_METRICS=1
